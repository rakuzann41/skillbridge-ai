# Reference only. Use frontend/.env.local and backend/.env for actual values.
# The frontend and backend must point to the same Supabase project.

# frontend/.env.local (public browser configuration)
NEXT_PUBLIC_API_URL=http://127.0.0.1:8000
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# backend/.env
FRONTEND_ORIGIN=http://127.0.0.1:3000
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=

# No service-role key, database password, or JWT secret is used in step 2.

# backend/.env only; scripts/setup_headhunter.py configures these after approval.
HH_ACCESS_TOKEN=
HH_USER_AGENT=
ANALYSIS_SIGNING_KEY=
